{
  "style": "pencil",
  "data": {
    "directory_lease": {"from":"regex","path":"crates/relay-core/src/store/directory.rs","pattern":"DIRECTORY_LEASE: Duration = Duration::from_secs\\((\\d+)\\)"},
    "wg_net": {"from":"regex","path":"scripts/relay-admin","pattern":"(?m)^WG_NET=(\\S+)"},
    "hub_raw": {"from":"regex","path":"scripts/relay-admin","pattern":"(?m)^HUB_ADDR=(\\S+)"},
    "hub_addr": {"from":"expr","value":"replace(hub_raw, '$WG_NET', wg_net)"},
    "bus_port": {"from":"regex","path":"scripts/relay-admin","pattern":"(?m)^BUS_PORT=(\\S+)"},
    "escalation_body": {"from":"regex","path":"crates/relay-core/src/escalation.rs","pattern":"(?s)pub enum EscalationStatus \\{(.*?)\\}"},
    "states": {"from":"expr","value":"lower(findall(escalation_body, '(?m)^\\s*([A-Z][a-z]+),'))"},
    "hook_lease": {"from":"regex","path":"crates/relay-core/src/store/inflight.rs","pattern":"HOOK_LEASE: Duration = Duration::from_secs\\((\\d+)\\)"},
    "watcher_lease": {"from":"regex","path":"crates/relay-core/src/store/inflight.rs","pattern":"WATCHER_LEASE: Duration = Duration::from_secs\\((\\d+)\\)"},
    "max_redeliveries": {"from":"regex","path":"crates/relay-core/src/store/inflight.rs","pattern":"MAX_REDELIVERIES: u32 = (\\d+);"},
    "dead_cap_thousands": {"from":"regex","path":"crates/relay-core/src/store/inflight.rs","pattern":"DEAD_LETTER_CAP: usize = (\\d+)_\\d{3};"},
    "dead_cap_units": {"from":"regex","path":"crates/relay-core/src/store/inflight.rs","pattern":"DEAD_LETTER_CAP: usize = \\d+_(\\d{3});"}
  },
