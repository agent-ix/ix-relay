# systemd user unit, the hub only (AGE-2067): the bus's address, 10.99.0.1:6380
# on the hub's WireGuard interface wg0. Leads on every machine, the hub included,
# connect here; relay-redis-proxy.service carries each connection to
# relay-redis inside the kind cluster. Replaces redis-port-forward.service
# (`kubectl port-forward`) for the relay. See README.md "Transport".
#
#   cp deploy/relay-redis-proxy.{socket,service} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now relay-redis-proxy.socket
[Unit]
Description=ix-relay bus address on wg0 (10.99.0.1:6380)

[Socket]
ListenStream=10.99.0.1:6380
# Bind even while wg0 is not up yet (boot order, or wg-quick restarted);
# connections arrive once it is.
FreeBind=yes

[Install]
WantedBy=sockets.target
